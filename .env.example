# Supabase Environment Configuration Template
# Azim Premji School - Campus Biodiversity Project
#
# Duplicate this file as .env.local and populate with your project credentials:
# (Found in Supabase Dashboard -> Settings -> API)

# Public URL & anonymous key (Safe for browser / public reads with RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key (NEVER prefix with NEXT_PUBLIC_)
# Only used server-side for generating signed URLs for published photographs from the private bucket
SUPABASE_SERVICE_ROLE_KEY=
